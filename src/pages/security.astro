---
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import { contractAnswers, securityIsLinked } from '../facts';
import { INVOICE, FACTURA_ES, LIVRAISON_FR, CALL_SUMMARY } from '../data/documents';

// Ce que Syntexia peut mettre dans un contrat, et ce que ce site ne fait pas.
// Chaque réponse vient de contractAnswers dans facts.ts, avec sa source ; la
// page est liée depuis la navigation et le pied de page dès qu'il y en a au
// moins trois (securityIsLinked). Tant qu'elle ne l'est pas, elle n'est ni
// indexée ni dans le plan du site.
//
// Rééquilibrée le 2026-10-09 (retours de Karim : le bas du site penchait
// vers l'audit). Le titre ne reprend plus l'ancien titre des factures, les
// pièces ne sont plus une balance et une feuille de temps mais ce que
// traitent les deux offres de l'accueil : des pièces d'achat en trois
// langues et le résumé d'un appel, celui de la démonstration voix.
//
// Toutes les pièces sont entièrement fictives (src/data/documents.ts). Elles
// illustrent une forme, pas un client.
---

<Base
  title="What Syntexia can put in a contract"
  description="The limits our systems work within, for your orders, invoices, calls and files, and what this website does not do."
  path="/security"
  noindex={!securityIsLinked}
>
  <section class="section first">
    <div class="shell split">
      <div>
        <h1>What we can put in a contract.</h1>
        <p class="lead">
          Our systems work within limits we can write into a contract, for your orders,
          invoices, calls and files. Here they are, with what this website does not do.
        </p>
        <p class="acts"><a class="btn btn-primary" href="/#contact">Book a call</a></p>
      </div>

      <div class="pile">
        <Sheet doc={INVOICE} />
        <Sheet doc={FACTURA_ES} />
        <Sheet doc={LIVRAISON_FR} />
        <Sheet doc={CALL_SUMMARY} />
        <p class="legend">Illustrative documents in four languages. No customer data.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="answers-title">
    <div class="shell">
      <h2 id="answers-title">The answers</h2>
      <div class="answers">
        {contractAnswers.map((a) => (
          <div class="answer">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .first { border-top: 0; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-9); align-items: start; }
  .lead { margin-top: var(--s-5); font-size: var(--t-lead); line-height: 1.45; max-width: 36ch; }
  .acts { margin-top: var(--s-6); }
  .pile { display: flex; flex-direction: column; gap: var(--s-4); }
  .legend { font-size: var(--t-small); color: var(--meta); margin-top: var(--s-2); }
  .answers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s-7) var(--s-6);
    margin-top: var(--s-6);
  }
  .answer {
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }
  .answer p { margin-top: var(--s-3); }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; gap: var(--s-7); }
  }
</style>
