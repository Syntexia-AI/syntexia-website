---
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import { contractAnswers, securityIsLinked } from '../facts';
import { INVOICE, BALANCE, TIMESHEET } from '../data/documents';

// Ce que Syntexia peut mettre dans un contrat, et ce que ce site ne fait pas.
// Chaque réponse vient de contractAnswers dans facts.ts, avec sa source ; la
// page est liée depuis la navigation et le pied de page dès qu'il y en a au
// moins trois (securityIsLinked). Tant qu'elle ne l'est pas, elle n'est ni
// indexée ni dans le plan du site.
//
// Les trois documents sont entièrement fictifs (src/data/documents.ts). Ils
// illustrent une forme, pas un client.
---

<Base
  title="What Syntexia can put in a contract"
  description="What the systems read, and what this website does not do."
  path="/security"
  noindex={!securityIsLinked}
>
  <section class="section first">
    <div class="shell split">
      <div>
        <h1>We read the paperwork nobody wants to read.</h1>
        <p class="lead">
          Supplier invoices, trial balances, timesheets, audit working papers. Read,
          checked against the source, and prepared inside the software your team already uses.
        </p>
        <p class="acts"><a class="btn btn-primary" href="/#contact">Send us a document</a></p>
      </div>

      <div class="pile">
        <Sheet heading={INVOICE.heading} rows={INVOICE.rows} total={INVOICE.total} />
        <Sheet heading={BALANCE.heading} rows={BALANCE.rows} total={BALANCE.total} />
        <Sheet heading={TIMESHEET.heading} rows={TIMESHEET.rows} />
        <p class="legend">Illustrative documents. No customer data.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <h2>What we can put in a contract</h2>
      <div class="answers">
        {contractAnswers.map((a) => (
          <div class="answer">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>

    </div>
  </section>
</Base>

<style>
  .first { border-top: 0; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-9); align-items: start; }
  .lead { margin-top: var(--s-5); font-size: var(--t-body); }
  .acts { margin-top: var(--s-6); }
  .pile { display: flex; flex-direction: column; gap: var(--s-4); }
  .legend { font-size: var(--t-small); color: var(--meta); margin-top: var(--s-2); }
  .answers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s-6);
    margin-top: var(--s-6);
  }
  .answer p { margin-top: var(--s-3); }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; gap: var(--s-7); }
  }
</style>
