---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { serializeJsonLd } from '../../lib/jsonld';
import { monthYear, isoDate } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const site = 'https://www.syntexia.ai';
const iso = isoDate(post.data.date);
const human = monthYear(post.data.date);

// Un article signé par la société est attribué à une organisation, pas à une
// personne.
const byCompany = post.data.author.startsWith('Syntexia');
const publisher = { '@type': 'Organization', name: 'Syntexia.AI', url: site };

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: iso,
  image: `${site}/og-image.png`,
  mainEntityOfPage: `${site}/posts/${post.id}`,
  author: byCompany ? publisher : { '@type': 'Person', name: post.data.author },
  publisher,
};
---

<Base title={post.data.title} description={post.data.description} path={`/posts/${post.id}`} ogType="article">
  <article class="section first">
    <div class="shell">
      <p class="meta">
        <time class="tabular" datetime={iso}>{human}</time>
        <span class="topic">{post.data.topic}</span>
        <span>{post.data.author}</span>
      </p>
      <h1>{post.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
      <p class="back"><a href="/blog">All insights</a></p>
    </div>
  </article>
  <script type="application/ld+json" is:inline set:html={serializeJsonLd(articleLd)}></script>
</Base>

<style>
  .first { border-top: 0; }
  .meta { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); font-size: var(--t-small); color: var(--meta); margin-bottom: var(--s-5); }
  .meta .topic { color: var(--fg); font-weight: 560; }
  .prose { margin-top: var(--s-7); max-width: var(--measure); }
  .prose :global(p) { margin-bottom: var(--s-5); }
  .prose :global(h2) { margin: var(--s-8) 0 var(--s-4); }
  .prose :global(h3) { margin: var(--s-7) 0 var(--s-3); }
  /* base.css retire les puces de toutes les listes ; un article les rend. */
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 var(--s-5); padding-left: 1.25em; color: var(--fg-2); }
  .prose :global(ul) { list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li) { margin-bottom: var(--s-2); padding-left: 0.25em; }
  .prose :global(blockquote) {
    border-left: 2px solid var(--rule);
    padding-left: var(--s-5);
    margin: var(--s-6) 0;
  }
  .prose :global(em) { font-style: italic; }
  .prose :global(a) { color: var(--fg); }
  .back { margin-top: var(--s-8); }
</style>
