---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist." path="/404">
  <section class="section first">
    <div class="shell">
      <h1>That page does not exist.</h1>
      <p class="lead">It may have been removed, or the address may be wrong.</p>
      <p class="acts"><a class="btn btn-primary" href="/">Go to the home page</a></p>
    </div>
  </section>
</Base>

<style>
  .first { border-top: 0; }
  .lead { margin-top: var(--s-5); }
  .acts { margin-top: var(--s-6); }
</style>
