---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import MarkCanvas from '../components/MarkCanvas.astro';
import DocumentStack from '../components/DocumentStack.astro';
import AppFrame from '../components/AppFrame.astro';
import AuditFlow from '../components/AuditFlow.astro';
import Pillars from '../components/Pillars.astro';
import Strip from '../components/Strip.astro';
import { getCollection } from 'astro:content';
import { sectors, partnerNetworkUrl, partnerNetwork, location } from '../facts';

// Copy repris de l'ancien site, commit c887605, src/sections.jsx.
// C'est le meilleur matériau dont nous disposons, et il n'est pas centré sur la
// voix : il décrit une couche d'intelligence. Trois nettoyages, imposés par la
// section 2 de la directive :
//   - « quiet, embedded, always on » retiré, triplet parallèle.
//   - « reading, routing, drafting, reconciling, anticipating » retiré, c'est
//     le motif « reads, routes, drafts » explicitement interdit.
//   - « Live in real organizations, every day » retiré, statut non sourcé.
// Les emphases dans les titres sont retirées, elles sont interdites.

const eyebrow = 'Intelligence Layer';
const heading = 'Intelligence that lives in your ecosystem.';
const sub =
  'Not a chatbot. Not a co-pilot. A real intelligence layer that runs inside the systems your business already uses: quiet, embedded, always on.';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---

<Base
  title="Syntexia. Intelligence that lives in your ecosystem."
  description={sub}
  path="/"
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-text" data-anim>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        <p class="lead">{sub}</p>
        <div class="acts">
          <a class="btn btn-primary" href="#contact">Book a call</a>
          <a class="btn btn-secondary" href="#what">See what it does</a>
        </div>
      </div>
      <MarkCanvas class="hero-mark" size={400} />
    </div>
  </section>

  <Strip />

  <section class="band" id="product">
    <div class="shell">
      <div data-anim><AppFrame /></div>
    </div>
  </section>

  <section class="section" id="flow">
    <div class="shell">
      <h2 class="section-title" data-anim>The order a firm actually works in.</h2>
      <div data-anim><AuditFlow /></div>
    </div>
  </section>

  <section class="band" id="what">
    <div class="shell">
      <h2 class="section-title" data-anim>Four things your Intelligence does, every day.</h2>
      <div data-anim><Pillars /></div>
    </div>
  </section>

  <section class="section" id="paperwork">
    <div class="shell paper-grid">
      <div class="paper-text" data-anim>
        <h2>We read the paperwork nobody wants to read.</h2>
        <p>
          Supplier invoices, trial balances, timesheets, audit working papers. Read,
          checked against the source, and prepared inside the software your team
          already uses.
        </p>
        <p class="paper-note">
          The agent prepares the file. The auditor validates it. Nothing is concluded
          without a person signing it.
        </p>
        <p><a href="/security">What we can put in a contract</a></p>
      </div>
      <div class="pile" data-anim>
        <DocumentStack />
      </div>
    </div>
  </section>

  <section class="band" id="sectors">
    <div class="shell">
      <h2 class="section-title" data-anim>What we run today</h2>
      <div class="sectors">
        {sectors.map((s) => (
          <div class="sector" data-anim>
            <h3>{s.name}</h3>
            <p>{s.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {partnerNetworkUrl && (
    <section class="section">
      <div class="shell">
        <h2 class="section-title" data-anim>Anthropic Claude Partner Network</h2>
        <p>
          Syntexia is a member of the network.
          <a href={partnerNetworkUrl.value} rel="noopener">Read the announcement</a>.
        </p>
      </div>
    </section>
  )}

  <section class="section invert" id="about">
    <div class="shell about-grid">
      <div data-anim>
        <h2>An intelligence company, not an AI vendor.</h2>
      </div>
      <div class="about-body" data-anim>
        <p>
          Syntexia is an intelligence company. We help organisations put intelligence
          at the core of how they operate, decide, and grow: intelligence that lives in
          their business ecosystem, runs their present, and shows them the future.
        </p>
        <p>
          We work across audit and assurance, and answer the phone for firms that would
          rather their people did something else. Our products run inside the software
          those firms already use.
        </p>
        {location && <p class="about-where">{location.value}</p>}
        {partnerNetwork && (
          <p class="about-partner">
            {partnerNetworkUrl
              ? <a href={partnerNetworkUrl.value} rel="noopener">{partnerNetwork.value}</a>
              : partnerNetwork.value}
          </p>
        )}
        <p><a href="/about">More about the company</a></p>
      </div>
    </div>
  </section>

  <section class="section" id="insights">
    <div class="shell">
      <h2 class="section-title" data-anim>Insights</h2>
      <div class="insights">
        {posts.map((p) => (
          <a class="insight" href={`/posts/${p.id}`} data-anim>
            <span class="insight-date tabular">{fmt(p.data.date)}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="contact">
    <div class="shell">
      <p class="eyebrow" data-anim>Let's put intelligence inside your business</p>
      <h2 class="cta-title" data-anim>Run your present. See your future.</h2>
      <p class="contact-lead" data-anim>
        Tell us what you want it to do. We answer within a working day, and if you
        would rather describe it out loud, say so and we will call you.
      </p>
      <ContactForm />
    </div>
  </section>
</Base>

<style>
  /* Rythme de la page. La profondeur vient de blocs pleins alternés et de
     filets d'un pixel, jamais d'une ombre. L'accent cuivré ne sert qu'aux
     actions : il n'apparaît dans aucun fond. */
  .band {
    padding: var(--s-9) 0;
    background: var(--bg-2);
    border-top: 1px solid var(--line-soft);
  }

  /* ---------- Accroche ---------- */

  .hero { padding: var(--s-10) 0 var(--s-9); }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-9);
    align-items: center;
  }

  .hero h1 { max-width: 15ch; }

  .eyebrow {
    font-size: var(--t-small);
    line-height: var(--lh-small);
    color: var(--accent);
    margin-bottom: var(--s-5);
  }

  .lead {
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-2);
    margin-top: var(--s-6);
    max-width: 48ch;
  }

  /* Les boutons vivent dans l'accroche, donc visibles sans défiler. Ils étaient
     après les huit lignes horaires, mesurés à 1533 px sur desktop. */
  .acts { display: flex; flex-wrap: wrap; gap: var(--s-4); margin-top: var(--s-7); }

  .hero-mark { justify-self: end; }

  /* ---------- Piliers ---------- */

  .pillars {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-9) var(--s-8);
  }

  .pillar { border-top: 1px solid var(--line); padding-top: var(--s-5); }

  .pillar-label {
    font-size: var(--t-small);
    line-height: var(--lh-small);
    color: var(--mute);
    margin-bottom: var(--s-4);
  }

  .pillar h2 {
    font-size: var(--t-h3);
    line-height: var(--lh-h3);
    letter-spacing: -0.012em;
    max-width: 24ch;
  }

  .pillar-body { margin-top: var(--s-4); max-width: 46ch; }

  /* ---------- Paperasse ---------- */

  .paper-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-9);
    align-items: start;
  }

  .paper-text h2 { max-width: 16ch; }
  .paper-text p { margin-top: var(--s-5); }
  .paper-note { color: var(--ink); }

  .pile { display: flex; flex-direction: column; gap: var(--s-4); }

  .legend {
    font-size: var(--t-small);
    line-height: var(--lh-small);
    color: var(--mute-2);
    margin-top: var(--s-2);
  }

  /* ---------- Secteurs, insights, contact ---------- */

  .section-title { margin-bottom: var(--s-7); }

  .sectors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--s-8);
  }
  .sector { border-top: 1px solid var(--line); padding-top: var(--s-5); }
  .sector p { margin-top: var(--s-3); }

  .insights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--s-8);
  }
  .insight {
    display: block;
    text-decoration: none;
    border-top: 1px solid var(--line);
    padding-top: var(--s-5);
  }
  .insight-date { font-size: var(--t-small); color: var(--mute); }
  .insight h3 { margin-top: var(--s-3); max-width: 24ch; }
  .insight p { margin-top: var(--s-3); }
  .insight { transition: transform 0.28s cubic-bezier(0.22, 0.61, 0.36, 1), border-color 0.28s ease; }
  .insight:hover { transform: translateY(-4px); border-color: var(--accent); }
  .insight:hover h3 { color: var(--accent); }
  .sector { transition: border-color 0.28s ease; }
  .sector:hover { border-color: var(--mute); }
  @media (prefers-reduced-motion: reduce) {
    .insight { transition: none; }
    .insight:hover { transform: none; }
  }

  .contact-lead { margin-bottom: var(--s-7); max-width: 52ch; }

  .cta-title {
    font-size: var(--t-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    font-weight: 700;
    max-width: 18ch;
    margin-bottom: var(--s-6);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: var(--s-9);
    align-items: start;
  }
  .about-grid h2 { max-width: 16ch; }
  .about-body { display: flex; flex-direction: column; gap: var(--s-5); }
  .about-where { color: var(--ink); font-weight: 500; }
  .about-partner { color: var(--mute); font-size: var(--t-small); }
  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; gap: var(--s-6); }
  }

  /* ---------- Adaptation ---------- */

  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; gap: var(--s-7); }
    .hero-mark { justify-self: start; --mark3d-size: 240px; }
    .paper-grid { grid-template-columns: 1fr; gap: var(--s-7); }
  }

  @media (max-width: 720px) {
    .hero { padding: var(--s-8) 0 var(--s-7); }
    .pillars { grid-template-columns: 1fr; gap: var(--s-7); }
  }
</style>
