---
import Base from '../layouts/Base.astro';
import ContactBlock from '../components/ContactBlock.astro';
import AutomationFlow from '../components/AutomationFlow.astro';
import CallTranscript from '../components/CallTranscript.astro';
import PartnerBlock from '../components/PartnerBlock.astro';
import Programmes from '../components/Programmes.astro';
import Pillars from '../components/Pillars.astro';
import BrandMark from '../components/BrandMark.astro';
import FullStop from '../components/FullStop.astro';
import { getCollection } from 'astro:content';
import { sectors, location, cases, securityIsLinked } from '../facts';
import { monthYear } from '../lib/format';
import { sortPosts } from '../lib/posts';
import '../styles/home.css';

// Direction artistique d'octobre 2026, « le point au cœur » : voir
// docs/DA-2026-10.md.
//
// Recentrage du 2026-10-02, à la demande de Karim :
//   - l'accueil ouvre sur l'automatisation par l'IA, d'abord les factures
//     fournisseurs, puis sur la voix ; l'audit redevient un secteur parmi
//     d'autres, la démonstration d'acceptation et le flux d'audit quittent
//     l'accueil ;
//   - plus de mot « agent » : Syntexia est une couche d'intelligence ;
//   - « not an AI vendor » est retiré, « an intelligence company » suffit ;
//   - la société se présente comme européenne (voir location dans facts.ts).
//
// Recentrage du 2026-10-09, retours de Karim après relecture :
//   - l'automatisation montre la chaîne achats et finance en quatre étapes
//     (AutomationFlow) ; la démonstration de facture devient l'étape 3, et
//     ses pièces arrivent en quatre langues avec un écran en anglais ;
//   - les deux programmes Anthropic sont cités ensemble sous les boutons,
//     dans la bande partenariat et dans le pied de page ;
//   - Insights ne montre que les trois articles les plus récents, et chaque
//     article dit son sujet.
//
// Le titre est composé en trois lignes fixes. Son point final est le cœur du
// mark, et l'ancien sur-titre « Intelligence Layer » devient sa légende,
// dessinée en CSS (data-callout) pour que le texte du h1 reste exactement le
// titre. Le sur-titre reste lu en premier par les lecteurs d'écran.

const eyebrow = 'Intelligence Layer';
const sub =
  'Not a chatbot. Not a co-pilot. A real intelligence layer that runs inside the systems your business already uses: quiet, embedded, always on.';

// Ce que fait la société, dit dès le premier écran.
const offers = [
  {
    // Réécrit le 2026-10-09. Avant : « Starting with supplier invoices, in
    // any format: read, checked against the order, posted into your ERP. »
    href: '#automation',
    name: 'AI automation',
    desc: 'Purchasing and finance as one flow, from the forecast to the close. Invoices in any language, checked against the order and the agreed price.',
  },
  {
    href: '#voice',
    name: 'Voice AI',
    desc: 'A phone line that answers, confirms who is calling, and solves the request or opens a ticket.',
  },
];

// Les trois plus récents. Les autres restent sur /blog.
const posts = sortPosts(await getCollection('posts')).slice(0, 3);
---

<Base
  title="Syntexia. Intelligence that lives in your ecosystem."
  description={sub}
  path="/"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <p class="sr-only">{eyebrow}</p>
      <h1 class="hero-title" id="hero-title"><span class="l">Intelligence that</span> <span class="l">lives in your</span> <span class="l nw">ecosystem<span class="sr-only">.</span><span class="hero-point" aria-hidden="true" data-callout={eyebrow}><i class="dot"></i></span></span></h1>
      <p class="hero-legend" aria-hidden="true"><i class="dot"></i>{eyebrow}</p>

      <div class="grid hero-foot">
        <p class="hero-lead">{sub}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#contact">Book a call</a>
          <a class="text-link" href="#what">See what it does</a>
        </div>
        <div class="hero-progs">
          <Programmes variant="hero" />
        </div>
        <ul class="offers" aria-label="What we do">
          {offers.map((o) => (
            <li>
              <a href={o.href}>
                <span class="offer-name">{o.name}</span>
                <span class="offer-desc">{o.desc}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="band on-desk" id="automation" aria-labelledby="automation-title">
    <div class="wrap">
      <div class="grid case-intro">
        <h2 class="h2" id="automation-title">It starts before the <FullStop>invoice</FullStop></h2>
        <div class="case-text">
          <p>{cases.automation.flow}</p>
          <p>{cases.automation.rule}</p>
          {securityIsLinked && (
            <p><a class="text-link" href="/security">What we can put in a contract</a></p>
          )}
        </div>
      </div>
      <AutomationFlow />
    </div>
  </section>

  <section class="band on-black" id="voice" aria-labelledby="voice-title">
    <div class="wrap">
      <div class="grid case-intro">
        <h2 class="h2" id="voice-title">It picks up the <FullStop>phone</FullStop></h2>
        <div class="case-text">
          <p>{cases.voice.flow}</p>
        </div>
      </div>
      <CallTranscript />
    </div>
  </section>

  <PartnerBlock />

  <section class="band on-black" id="what" aria-labelledby="what-title">
    <div class="wrap">
      <h2 class="h2 h2-wide" id="what-title">Four things your Intelligence does, every <FullStop>day</FullStop></h2>
      <Pillars />
    </div>
  </section>

  <section class="band" id="sectors" aria-labelledby="sectors-title">
    <div class="wrap">
      <h2 class="h2" id="sectors-title">Built for the work that cannot be <FullStop>wrong</FullStop></h2>
      <ul class="sector-index">
        {sectors.map((s) => (
          <li>
            <h3>{s.name}</h3>
            <p>{s.blurb}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <div class="wrap" aria-hidden="true"><hr class="divider" /></div>

  <section class="band" id="about" aria-labelledby="about-title">
    <div class="wrap grid about-grid">
      <h2 class="h2 about-title" id="about-title">An intelligence <FullStop>company</FullStop></h2>
      <div class="about-mark">
        <BrandMark size="xl" draw />
      </div>
      <div class="about-body">
        <p>
          Syntexia is an intelligence company. We help organisations put intelligence
          at the core of how they operate, decide, and grow: intelligence that lives in
          their business ecosystem, runs their present, and shows them the future.
        </p>
        <p>
          We automate purchasing and finance, from the forecast to the close, and answer
          the phone for organisations that would rather their people did something else.
          Our products run inside the software those organisations already use.
        </p>
        {location && <p class="about-where">{location.value}</p>}
        <p><a class="text-link" href="/about">More about the company</a></p>
      </div>
    </div>
  </section>

  <div class="wrap" aria-hidden="true"><hr class="divider" /></div>

  <section class="band" id="insights" aria-labelledby="insights-title">
    <div class="wrap">
      <div class="insights-head">
        <h2 class="h2" id="insights-title">Insights</h2>
        <a class="text-link" href="/blog">All insights</a>
      </div>
      <ol class="posts">
        {posts.map((p) => (
          <li>
            <a class="post" href={`/posts/${p.id}`}>
              <span class="post-meta">
                <span class="post-date tabular">{monthYear(p.data.date)}</span>
                <span class="post-topic">{p.data.topic}</span>
              </span>
              <span class="post-title">{p.data.title}</span>
              <span class="post-desc">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band on-black contact" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <p class="contact-intro">Let’s put intelligence inside your business</p>
      <h2 class="contact-title" id="contact-title"><span class="l">Run your present.</span> <span class="l">See your <FullStop>future</FullStop></span></h2>
      <div class="grid contact-grid">
        <p class="contact-lead">
          Tell us what you want it to do. We answer within a working day, and if you
          would rather describe it out loud, say so and we will call you.
        </p>
        <div class="contact-block">
          <ContactBlock />
        </div>
      </div>
    </div>
  </section>
</Base>
