---
import Base from '../layouts/Base.astro';
import { linkedinCompany, contactEmail, team, hardRules } from '../facts';

// Deux fiches. Nom et fonction viennent de team.html, seule source existante.
// Les biographies et les photos ne sont pas sourcées, donc rien n'est rendu à
// leur place : ni texte d'attente, ni silhouette générique.

---

<Base
  title="The team behind Syntexia.AI"
  description="Who builds and runs the systems, and the two rules they are built under."
  path="/team"
>
  <section class="section first">
    <div class="shell">
      <h1>The team behind Syntexia.AI</h1>
      <p class="team-lead">
        A small team of engineers and former practitioners who have seen the work from the
        inside, and decided the right way to apply intelligence is alongside the people
        doing it.
      </p>
      <div class="people">
        {team.map((p) => (
          <article class="person">
            <h2>{p.name}</h2>
            <p class="role">{p.role}</p>
            {p.bio.map((para) => <p class="bio">{para}</p>)}
            {p.linkedin && <p><a href={p.linkedin} rel="noopener">LinkedIn</a></p>}
          </article>
        ))}
      </div>

      <div class="rules">
        <h2>The two rules we build under</h2>
        <ol>
          {hardRules.map((r) => <li>{r}</li>)}
        </ol>
        <p class="rules-note">
          In regulated work, an almost-right answer costs more than no answer at all.
          These two hold on every build, without exception.
        </p>
      </div>

      <div class="team-more">
        <p>
          We are hiring for the work we cannot do fast enough. If you have run audits,
          answered phones for a living, or built systems that other people depend on,
          write to us.
        </p>
        <p class="team-links">
          <a href={`mailto:${contactEmail.value}`}>{contactEmail.value}</a>
          {linkedinCompany && <a href={linkedinCompany.value} rel="noopener">LinkedIn</a>}
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .first { border-top: 0; }
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s-7);
    margin-top: var(--s-7);
  }
  .person { border-top: 1px solid var(--line); padding-top: var(--s-5); }
  .role { margin-top: var(--s-2); color: var(--mute); }
  .person p + p { margin-top: var(--s-4); }
  .team-lead { margin-top: var(--s-6); font-size: 19px; line-height: 1.55; max-width: 54ch; }
  .bio { margin-top: var(--s-4); font-size: var(--t-body); line-height: 1.6; }
  .rules {
    margin-top: var(--s-9);
    padding: var(--s-7) 0 0;
    border-top: 1px solid var(--line);
  }
  .rules ol {
    margin: var(--s-5) 0 0 var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .rules li { font-size: 19px; line-height: 1.45; color: var(--ink); max-width: 46ch; }
  .rules-note { margin-top: var(--s-5); max-width: 56ch; }
  .team-more {
    margin-top: var(--s-9);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
    max-width: 60ch;
  }
  .team-links { display: flex; flex-wrap: wrap; gap: var(--s-6); margin-top: var(--s-5); }
  .team-links a { color: var(--ink); }
</style>
