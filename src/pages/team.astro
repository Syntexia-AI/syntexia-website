---
import Base from '../layouts/Base.astro';
import FullStop from '../components/FullStop.astro';
import { linkedinCompany, contactEmail, team, hardRules } from '../facts';

// Une fiche par personne de team, dans facts.ts, qui porte les sources des
// noms, fonctions et biographies. Une fiche n'est ajoutée qu'avec l'accord
// écrit de la personne, et son nom n'apparaît dans ce dépôt public qu'après
// cet accord. Un portrait n'est rendu que
// s'il a été fourni par la personne : sinon sa colonne reste vide, sans
// silhouette ni initiales.
//
// Recrutement, réécrit le 2026-10-09 pour sortir de l'audit (retours de
// Karim). Avant : « If you have run audits, answered phones for a living, or
// built systems that other people depend on, write to us. »
//
// Les portraits passent en noir et blanc par CSS, pour que des photos prises
// dans des lumières différentes tiennent ensemble dans la palette du site.
// Les fichiers restent en couleur : une ligne à retirer pour revenir à la
// couleur.
//
// Les deux règles ont leur point final en cuivre : ce sont les règles que
// suit l'intelligence, et le cuivre marque ce qui la concerne.

const rules = hardRules.map((r) => {
  const text = r.replace(/\.$/, '');
  const cut = text.lastIndexOf(' ');
  return { head: text.slice(0, cut + 1), last: text.slice(cut + 1) };
});
---

<Base
  title="The team behind Syntexia.AI"
  description="Who builds and runs the systems, and the two rules they are built under."
  path="/team"
>
  <section class="team-hero">
    <div class="wrap">
      <h1>The team behind Syntexia.AI</h1>
      <p class="team-lead">
        A small team of engineers and former practitioners who have seen the work from the
        inside, and decided the right way to apply intelligence is alongside the people
        doing it.
      </p>
    </div>
  </section>

  <section class="team-people" aria-label="People">
    <div class="wrap">
      {team.map((p) => (
        <article class="person grid">
          {p.photo && (
            <div class="person-photo">
              <picture>
                <source
                  type="image/webp"
                  srcset={`${p.photo.base}-560.webp 560w, ${p.photo.base}-1120.webp 1120w`}
                  sizes="(max-width: 760px) 100vw, 30vw"
                />
                <img
                  src={`${p.photo.base}-1120.jpg`}
                  width="1120"
                  height="1400"
                  alt={p.photo.alt}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
          )}
          <div class="person-text">
            <h2>{p.name}</h2>
            <p class="role">{p.role}</p>
            {p.bio.map((para) => <p class="bio">{para}</p>)}
            {p.linkedin && (
              <p class="person-link">
                <a class="text-link" href={p.linkedin} rel="noopener">LinkedIn</a>
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="band on-black team-rules" aria-labelledby="rules-title">
    <div class="wrap">
      <h2 id="rules-title">The two rules we build under</h2>
      <ol class="rules">
        {rules.map((r, i) => (
          <li>
            <span class="rule-i tabular">{`0${i + 1}`}</span>
            <span class="rule-text">{r.head}<FullStop>{r.last}</FullStop></span>
          </li>
        ))}
      </ol>
      <p class="rules-note">
        In regulated work, an almost-right answer costs more than no answer at all.
        These two hold on every build, without exception.
      </p>
    </div>
  </section>

  <section class="band team-more">
    <div class="wrap">
      <p class="hiring">
        We are hiring for the work we cannot do fast enough. If you have done the work we
        automate, or you build systems other people depend on, write to us.
      </p>
      <p class="team-links">
        <a class="text-link" href={`mailto:${contactEmail.value}`}>{contactEmail.value}</a>
        {linkedinCompany && (
          <a class="text-link" href={linkedinCompany.value} rel="noopener">LinkedIn</a>
        )}
      </p>
    </div>
  </section>
</Base>

<style>
  .team-hero {
    padding-block: clamp(48px, 7vw, 112px) clamp(56px, 7vw, 104px);
  }

  .team-lead {
    margin-top: clamp(28px, 3vw, 44px);
    font-size: var(--t-lead);
    line-height: 1.42;
    max-width: 44ch;
  }

  .team-people {
    padding-bottom: var(--section);
  }

  .person {
    row-gap: 32px;
    align-items: start;
    padding-block: clamp(40px, 5vw, 72px);
    border-top: 1px solid var(--rule);
  }

  .person-photo {
    grid-column: 1 / span 4;
  }

  /* Noir et blanc, léger contraste : la palette du site n'a pas de couleur
     en dehors du cuivre, les portraits non plus. */
  .person-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--desk);
    filter: grayscale(1) contrast(1.04);
  }

  .person-text {
    grid-column: 6 / span 6;
  }

  .person-text h2 {
    font-size: clamp(32px, 4vw, 60px);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .role {
    margin-top: 12px;
    font-size: 16px;
    color: var(--meta);
  }

  .bio {
    margin-top: 22px;
    font-size: 18px;
    line-height: 1.6;
    max-width: 56ch;
  }

  .person-link {
    margin-top: 26px;
  }

  /* ---------- Les deux règles ---------- */

  .rules {
    margin-top: clamp(40px, 5vw, 72px);
    border-top: 1px solid var(--rule);
  }

  .rules li {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: var(--gap);
    align-items: baseline;
    padding-block: clamp(24px, 3vw, 40px);
    border-bottom: 1px solid var(--rule);
  }

  .rule-i {
    font-size: var(--t-small);
    color: var(--meta);
  }

  .rule-text {
    font-size: clamp(28px, 3.8vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: var(--w-title);
    color: var(--fg);
    text-wrap: balance;
  }

  .rules-note {
    margin-top: clamp(32px, 4vw, 56px);
    margin-left: calc(64px + var(--gap));
    font-size: 18px;
    line-height: 1.6;
    max-width: 52ch;
  }

  /* ---------- Recrutement ---------- */

  .hiring {
    font-size: var(--t-lead);
    line-height: 1.42;
    color: var(--fg);
    max-width: 44ch;
  }

  .team-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    margin-top: 28px;
  }

  @media (max-width: 900px) {
    .person-photo {
      grid-column: 1 / span 6;
    }
    .person-text {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .person-photo,
    .person-text {
      grid-column: 1 / -1;
    }
    .person-photo {
      max-width: 420px;
    }
    .rules li {
      grid-template-columns: 36px minmax(0, 1fr);
    }
    .rules-note {
      margin-left: 0;
    }
  }
</style>
