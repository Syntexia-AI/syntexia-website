---
import Base from '../layouts/Base.astro';
import { linkedinCompany, contactEmail } from '../facts';

// Deux fiches. Nom et fonction viennent de team.html, seule source existante.
// Les biographies et les photos ne sont pas sourcées, donc rien n'est rendu à
// leur place : ni texte d'attente, ni silhouette générique.
const PEOPLE = [
  {
    name: 'Karim Vissangy',
    role: 'CEO and Chief AI Officer',
    linkedin: 'https://www.linkedin.com/in/karim-vissangy-17aa893a/',
  },
  {
    name: 'Baptiste Bouault',
    role: 'CTO',
    linkedin: null,
  },
];
---

<Base
  title="The team behind Syntexia"
  description="Who builds and runs the voice and document systems."
  path="/team"
>
  <section class="section first">
    <div class="shell">
      <h1>The team behind Syntexia.AI</h1>
      <p class="team-lead">
        A small team of engineers and former practitioners who have seen the work from the
        inside, and decided the right way to apply intelligence is alongside the people
        doing it.
      </p>
      <div class="people">
        {PEOPLE.map((p) => (
          <div class="person">
            <h2>{p.name}</h2>
            <p class="role">{p.role}</p>
            {p.linkedin && <p><a href={p.linkedin} rel="noopener">LinkedIn</a></p>}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .first { border-top: 0; }
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s-7);
    margin-top: var(--s-7);
  }
  .person { border-top: 1px solid var(--line); padding-top: var(--s-5); }
  .role { margin-top: var(--s-2); color: var(--mute); }
  .person p + p { margin-top: var(--s-4); }
  .team-lead { margin-top: var(--s-6); font-size: 19px; line-height: 1.55; max-width: 54ch; }
  .team-more {
    margin-top: var(--s-9);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
    max-width: 60ch;
  }
  .team-links { display: flex; flex-wrap: wrap; gap: var(--s-6); margin-top: var(--s-5); }
  .team-links a { color: var(--ink); }
</style>
