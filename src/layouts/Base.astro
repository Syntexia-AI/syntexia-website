---
import '../styles/tokens.css';
import '../styles/base.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { linkedinCompany } from '../facts';
import { serializeJsonLd } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: string;
  /** Pages à ne pas indexer, comme la 404 : ni canonical, ni og:url. */
  noindex?: boolean;
}

const { title, description, path, ogType = 'website', noindex = false } = Astro.props;
const site = 'https://www.syntexia.ai';
const canonical = `${site}${path}`;

// Le nom de la marque figure dans chaque titre, une seule fois.
const fullTitle = title.includes('Syntexia') ? title : `${title} | Syntexia`;

// JSON-LD Organization. Champs vérifiés uniquement : le nom et le domaine
// sont établis par le site lui-même, le logo est servi par nous. Aucune
// adresse, aucun fondateur, aucune date de création : rien de tout cela
// n'est sourcé. sameAs n'apparaît que si une URL société est vérifiée.
const orgLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Syntexia.AI',
  url: site,
  logo: `${site}/syntexia-mark-dark.svg`,
};
if (linkedinCompany) orgLd.sameAs = [linkedinCompany.value];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/syntexia-mark-dark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FFFFFF" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Syntexia" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-image.png`} />

    <script type="application/ld+json" is:inline set:html={serializeJsonLd(orgLd)}></script>

    {/* Analytics, disabled. While this stays commented out the site loads no
        third-party script, and /security can say so truthfully. Account and
        domain still to create, see DEPLOY-CHECKLIST.md.
        <script defer data-domain="syntexia.ai" src="https://plausible.io/js/script.js"></script> */}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
