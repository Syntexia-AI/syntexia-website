---
interface Props { hour: string; kind: string; text: string; }
const { hour, kind, text } = Astro.props;
---
<div class="day-row">
  <span class="day-hour tabular">{hour}</span>
  <span class="day-kind">{kind}</span>
  <p class="day-text">{text}</p>
</div>

<style>
  /* Tailles de la maquette (bloc .d2). Au dessus du plancher de 13px. */
  .day-row {
    display: grid;
    grid-template-columns: 92px 104px 1fr;
    gap: var(--s-5);
    align-items: baseline;
    padding: var(--s-5) 0;
    border-top: 1px solid var(--line-soft);
  }
  .day-hour {
    font-size: 23px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .day-kind {
    font-size: 13.5px;
    color: var(--mute);
  }
  .day-text {
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 62ch;
  }
  @media (max-width: 720px) {
    .day-row {
      grid-template-columns: 72px 1fr;
      row-gap: var(--s-2);
    }
    .day-text { grid-column: 1 / -1; }
  }
</style>
