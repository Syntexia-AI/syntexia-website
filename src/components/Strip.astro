---
// Le bandeau défilant de l'ancien site, restauré. C'est un des éléments qui
// le rendaient vivant.
//
// Son contenu, lui, est entièrement refait : l'original annonçait « Live in
// production », « UK Headquartered London », « Anthropic Claude Partner
// Network » et « Operations across Europe ». Aucune de ces quatre affirmations
// n'a de source. Les six ci-dessous en ont une, indiquée en regard.
const ITEMS = [
  'Embedded, not bolted on',                    // wording d'origine, catégorie A
  'The agent prepares. The auditor validates.',  // README kreston-intelligence
  'Inside the software the firm already uses',   // architecture
  'One deployment per firm',                     // architecture, jamais de donnée partagée
  'No cookies. No trackers.',                    // démontrable par le build
  'Registered in England and Wales',             // Companies House 16847343
];
const DOUBLED = [...ITEMS, ...ITEMS];
---

<div class="strip" aria-hidden="true">
  <div class="strip-track">
    {DOUBLED.map((t) => <span class="strip-item">{t}</span>)}
  </div>
</div>

<style>
  .strip {
    overflow: hidden;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    padding: var(--s-4) 0;
    background: var(--bg-2);
  }

  .strip-track {
    display: flex;
    gap: var(--s-8);
    width: max-content;
    animation: stripScroll 46s linear infinite;
  }

  .strip:hover .strip-track { animation-play-state: paused; }

  .strip-item {
    font-size: 14.5px;
    color: var(--mute);
    white-space: nowrap;
  }

  /* Le contenu est doublé, donc un défilement de la moitié boucle sans saut. */
  @keyframes stripScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip-track { animation: none; }
    .strip { overflow-x: auto; }
  }
</style>
