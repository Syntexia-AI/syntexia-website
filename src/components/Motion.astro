---
// Motion.astro
//
// Le système de mouvement du site. Un seul mécanisme, appliqué une fois par
// bloc : une apparition courte, opacité et translation verticale de 14 px.
// Recommandation 5 du rapport docs/benchmark/03-references-da.md.
//
// RÈGLE D'INGÉNIERIE, la plus importante de ce fichier :
// rien n'est caché par défaut. L'ancien site posait `.reveal { opacity: 0 }`
// en CSS et ne le levait qu'en JavaScript, ce qui faisait qu'un visiteur ou un
// moteur sans JS voyait une page vide. Ici, la classe `motion-ready` n'est
// posée sur <html> que par le script lui-même. Sans JavaScript, sans
// IntersectionObserver, ou en prefers-reduced-motion, absolument rien ne se
// cache et la page reste complète.
---

<script>
  const root = document.documentElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Trois conditions pour animer. Si une seule manque, on ne touche à rien.
  const canAnimate =
    'IntersectionObserver' in window && !reduced.matches && !root.classList.contains('motion-ready');

  if (canAnimate) {
    // À partir d'ici seulement, le CSS a le droit de masquer.
    root.classList.add('motion-ready');

    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-anim]'));

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;

          // Décalage interne à un groupe, pour que les enfants d'un même bloc
          // arrivent l'un après l'autre plutôt que tous ensemble. Plafonné à
          // 5 pas pour ne jamais tomber dans l'animation en cascade longue.
          const group = el.parentElement;
          const peers = group ? Array.from(group.querySelectorAll('[data-anim]')) : [];
          const index = Math.min(peers.indexOf(el), 5);
          el.style.transitionDelay = `${Math.max(0, index) * 70}ms`;

          el.dataset.animIn = 'true';
          io.unobserve(el);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );

    for (const el of items) io.observe(el);

    // Si le moteur change d'avis en cours de route, on rend tout visible et
    // on cesse d'animer. On ne laisse jamais un élément coincé à opacité 0.
    reduced.addEventListener('change', (e) => {
      if (!e.matches) return;
      io.disconnect();
      for (const el of items) {
        el.dataset.animIn = 'true';
        el.style.transitionDelay = '0ms';
      }
    });
  }
</script>

<style is:global>
  /* Aucune de ces règles ne s'applique tant que le script n'a pas confirmé
     qu'il peut animer. C'est la garantie que la page reste lisible sans JS. */

  .motion-ready [data-anim] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.62s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 0.62s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: opacity, transform;
  }

  .motion-ready [data-anim][data-anim-in='true'] {
    opacity: 1;
    transform: none;
    will-change: auto;
  }

  /* Ceinture et bretelles : si le système demande moins d'animation après
     coup, plus rien n'est masqué, quel que soit l'état du script. */
  @media (prefers-reduced-motion: reduce) {
    .motion-ready [data-anim] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
