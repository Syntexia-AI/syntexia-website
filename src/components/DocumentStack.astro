---
import Sheet from './Sheet.astro';

// Trois pièces posées sur le bureau, légèrement de travers, comme on les
// pose vraiment. Chacune reste lisible en entier : elles ne se recouvrent que
// sur leurs marges. Au survol, une pièce se redresse et se soulève.
//
// Les coches cuivre sont tracées l'une après l'autre quand la pile entre à
// l'écran. Sans JavaScript, ou si la pile est déjà visible au chargement,
// elles sont simplement là.
//
// Les données sont entièrement fictives, les raisons sociales caviardées.

const INVOICE = {
  heading: 'FATURA FT 2026/0148',
  rows: [
    { label: 'Fornecedor', value: '', redacted: true },
    { label: 'NIF', value: '', redacted: true },
    { label: 'Bacalhau demolhado 5 kg', value: '184,50' },
    { label: 'Azeite virgem extra 5 L', value: '96,20' },
    { label: 'Batata nova 25 kg', value: '41,75' },
  ],
  total: { label: 'Total', value: '322,45' },
};
const BALANCE = {
  heading: 'BALANCETE ANALITICO',
  rows: [
    { label: '21 Clientes', value: '418 902,11' },
    { label: '22 Fornecedores', value: '207 441,08' },
    { label: '31 Compras', value: '', redacted: true },
    { label: '63 Gastos com pessoal', value: '', redacted: true },
  ],
  total: { label: 'Diferenca', value: '0,00' },
};
const TIMESHEET = {
  heading: 'FOLHA DE HORAS',
  rows: [
    { label: 'Trabalho de campo', value: '7,5 h' },
    { label: 'Revisao', value: '3,0 h' },
    { label: 'Arquivo', value: '1,5 h' },
  ],
};
---

<div class="pile" data-sheets>
  <div class="slot slot-hours">
    <Sheet heading={TIMESHEET.heading} rows={TIMESHEET.rows} tick={0} />
  </div>
  <div class="slot slot-balance">
    <Sheet heading={BALANCE.heading} rows={BALANCE.rows} total={BALANCE.total} tick={3} />
  </div>
  <div class="slot slot-invoice">
    <Sheet heading={INVOICE.heading} rows={INVOICE.rows} total={INVOICE.total} tick={6} />
  </div>
</div>

<script>
  // Tracé des coches à l'entrée dans l'écran. On ne masque rien qui soit
  // déjà visible : si la pile est à l'écran au chargement, on n'y touche pas.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-sheets]').forEach((pile) => {
    if (reduced.matches || !('IntersectionObserver' in window)) return;
    const r = pile.getBoundingClientRect();
    if (r.top < window.innerHeight && r.bottom > 0) return;

    pile.classList.add('is-pending');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          pile.classList.add('is-drawing');
          requestAnimationFrame(() => pile.classList.remove('is-pending'));
          io.disconnect();
        }
      },
      { threshold: 0.3 }
    );
    io.observe(pile);
  });
</script>

<style>
  .pile {
    position: relative;
    height: 590px;
  }

  .slot {
    position: absolute;
    transform: rotate(var(--r));
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .slot :global(.sheet) {
    transition: box-shadow 0.45s ease;
  }

  .slot:hover {
    z-index: 5;
    transform: rotate(0deg) translateY(-8px);
  }

  .slot:hover :global(.sheet) {
    box-shadow: var(--shadow-lift);
  }

  .slot-hours {
    --r: 3deg;
    top: 0;
    right: 0;
    width: 44%;
    z-index: 1;
  }

  .slot-balance {
    --r: -2.2deg;
    top: 34px;
    left: 0;
    width: 55%;
    z-index: 2;
  }

  .slot-invoice {
    --r: 1deg;
    top: 276px;
    left: 23%;
    width: 58%;
    z-index: 3;
  }

  .pile.is-pending :global(.tick) {
    stroke-dashoffset: 20;
  }

  .pile.is-drawing :global(.tick) {
    transition: stroke-dashoffset 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: calc(var(--k) * 110ms + 250ms);
  }

  @media (max-width: 1180px) {
    .pile {
      height: 600px;
    }
  }

  /* Sur téléphone, les pièces s'empilent à plat, à peine de travers. */
  @media (max-width: 760px) {
    .pile {
      height: auto;
      display: flex;
      flex-direction: column;
    }
    .slot {
      position: relative;
      inset: auto;
      width: 100%;
    }
    .slot + .slot {
      margin-top: -22px;
    }
    .slot-hours {
      --r: 1.2deg;
    }
    .slot-balance {
      --r: -1.4deg;
    }
    .slot-invoice {
      --r: 0.6deg;
    }
    .slot:hover {
      transform: rotate(var(--r));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slot:hover {
      transform: rotate(var(--r));
    }
  }
</style>
