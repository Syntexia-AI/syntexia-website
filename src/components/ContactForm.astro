---
import { sectors, contactEmail } from '../facts';
---
<form
  class="contact-form"
  id="contact-form"
  method="post"
  action="/api/contact"
  data-fallback={contactEmail.value}
>
  <div class="grid">
    <div class="field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="cf-company">Company</label>
      <input id="cf-company" name="company" type="text" autocomplete="organization" />
    </div>
    <div class="field">
      <label for="cf-sector">Sector</label>
      <select id="cf-sector" name="sector">
        <option value="">Not listed</option>
        {sectors.map((s) => <option value={s.name}>{s.name}</option>)}
      </select>
    </div>
  </div>

  <div class="field">
    <label for="cf-message">What do you want it to do</label>
    <textarea id="cf-message" name="message" required></textarea>
  </div>

  <div class="honey" aria-hidden="true">
    <label for="cf-website">Leave this empty</label>
    <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="actions">
    <button class="btn btn-primary" type="submit">Send</button>
    <p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  // Pas de is:inline, pas de define:vars : le script est bundlé et servi
  // depuis notre origine, ce qui permet à la CSP de rester script-src 'self'
  // sans 'unsafe-inline'. L'adresse de repli passe par un data-attribute.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');

  if (form && status) {
    const fallbackEmail = form.dataset.fallback || 'office@syntexia.ai';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      button.disabled = true;
      status.textContent = 'Sending.';

      try {
        const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}) as Record<string, string>);

        if (res.ok) {
          form.reset();
          status.textContent = 'Sent. We answer within a working day.';
        } else if (res.status === 503) {
          status.textContent = `The form is not connected yet. Write to ${data.fallback || fallbackEmail}.`;
        } else {
          status.textContent = data.error || `Something went wrong. Write to ${fallbackEmail}.`;
        }
      } catch {
        status.textContent = `Something went wrong. Write to ${fallbackEmail}.`;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-form { display: flex; flex-direction: column; gap: var(--s-5); max-width: 620px; }
  .contact-form .grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  .contact-form .actions { display: flex; align-items: center; gap: var(--s-5); flex-wrap: wrap; }
  @media (max-width: 640px) {
    .contact-form .grid { grid-template-columns: 1fr; }
  }
</style>
