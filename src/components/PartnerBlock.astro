---
import FullStop from './FullStop.astro';
import Programmes from './Programmes.astro';
import { programmes } from '../facts';

// Le partenariat, en grand. Demandé le 2026-09-02, redessiné le 2026-10-09
// sur les retours de Karim (« the partnership gets lost at the moment ») : la
// bande porte désormais les deux programmes Anthropic ensemble, en registre
// pleine largeur, et ils sont aussi cités sous les boutons de l'accueil, dans
// le pied de page et sur About (composant Programmes).
//
// Trois choses qu'elle ne fait pas, volontairement :
//   1. Aucun logo Anthropic ni Claude. Nous n'avons pas d'autorisation
//      d'usage de leur marque. Citer le nom des programmes en toutes lettres
//      est légitime, reproduire leur identité visuelle ne l'est pas.
//   2. Aucun statut inventé. Noms et statuts viennent de facts.ts, qui en
//      porte les sources.
//   3. Aucun lien tant qu'aucune URL publique n'est renseignée.
//
// Le point final du titre est cuivre : Claude est l'intelligence dont il est
// question. La bande disparaît si aucun programme n'est renseigné.
//
// « a person signs the conclusion » devient « a person makes the decision »
// le 2026-10-09, comme sur About : la première tournure venait de l'audit.
---

{programmes.length > 0 && (
  <section class="band partner" aria-labelledby="partner-title">
    <div class="wrap">
      <div class="grid partner-grid">
        <h2 class="partner-title" id="partner-title">We build with <FullStop>Claude</FullStop></h2>
        <div class="partner-text">
          <p>
            Claude is the model family we believe sets the standard for the kind of careful,
            high-stakes work our customers operate in.
          </p>
          <p class="partner-note">
            The models change. What does not change is that a person makes the decision.
          </p>
        </div>
      </div>
      <div class="partner-list">
        <Programmes variant="register" />
      </div>
    </div>
  </section>
)}

<style>
  .partner-grid {
    align-items: end;
    row-gap: 28px;
  }

  .partner-title {
    grid-column: 1 / span 7;
    font-size: clamp(36px, 5vw, 76px);
    line-height: 0.96;
    letter-spacing: -0.038em;
    max-width: 12ch;
  }

  .partner-text {
    grid-column: 8 / span 5;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .partner-text p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg);
    max-width: 42ch;
  }

  .partner-text .partner-note {
    font-size: 15px;
    color: var(--meta);
  }

  .partner-list {
    margin-top: clamp(44px, 5.4vw, 80px);
  }

  @media (max-width: 900px) {
    .partner-title,
    .partner-text {
      grid-column: 1 / -1;
    }
  }
</style>
