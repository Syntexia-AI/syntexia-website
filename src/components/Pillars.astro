---
import { pillarMetrics } from '../facts';

// Les quatre piliers, en onglets. Structure et wording repris du commit
// c887605, src/sections.jsx, validés par Karim.
//
// Dessin : les quatre verbes en très grand, sur fond noir. Le verbe actif
// passe au blanc et reçoit le point cuivre, signe de ce que fait
// l'intelligence ; un filet cuivre sous lui mesure l'avance automatique.
//
// Deux différences avec l'original, et deux seulement :
//   1. Les tirets cadratins sont remplacés. C'est de la typographie, pas du
//      wording : la règle vaut pour tout ce que produit la maison.
//   2. Les métriques ne sont rendues que si elles sont sourcées dans
//      facts.ts. Le wording est validé, pas les chiffres.
//
// L'auto-avance fait un seul tour, et s'arrête dès que le visiteur prend la
// main (clic, clavier, focus d'un lecteur d'écran). Elle ne repart pas, et ne
// démarre pas si les piliers sont déjà à l'écran au chargement : on ne
// change pas un panneau que quelqu'un lit déjà.

const PILLARS = [
  {
    verb: 'Lives',
    label: 'It lives inside your systems',
    title: 'Intelligence that runs where your business already runs.',
    body:
      'Your Intelligence is not a separate platform staff log into. It runs inside the systems you already use: phones, inbox, documents, CRM, accounting, operations stack. Quiet, embedded, always on.',
    key: 'lives',
  },
  {
    verb: 'Communicates',
    label: 'It communicates with your teams',
    title: 'It picks up the phone, drafts the report, pulls the number.',
    body:
      'Your Intelligence speaks the language of the people who run your business, answering internal questions, drafting reports, surfacing the numbers that matter, inside the tools the team already uses.',
    key: 'communicates',
  },
  {
    verb: 'Acts',
    label: 'It acts alongside them',
    title: 'Not advice. It does the work, end to end.',
    body:
      "Scheduling, processing, routing, drafting, reconciling, escalating. The repetitive operations that consume your team's time happen automatically, accurately, and continuously, escalating only what needs a human.",
    key: 'acts',
  },
  {
    verb: 'Shows',
    label: 'It shows you what is next',
    title: 'Foresight that surfaces what matters before it becomes urgent.',
    body:
      'Your Intelligence does not only describe what already happened. It looks forward, at your data, patterns, risks and opportunities, and tells your team what to act on now to change the outcome.',
    key: 'shows',
  },
];
---

<div class="grid tabs" data-pillars>
  <!-- Sans JavaScript, les verbes ne sont qu'un titre visuel : la liste est
       masquée aux technologies d'assistance, qui lisent les quatre panneaux.
       Le script pose les rôles d'onglets quand il les rend utilisables. -->
  <div class="tablist" aria-hidden="true" data-tablist>
    {PILLARS.map((p, i) => (
      <button type="button" class="tab" id={`tab-${p.key}`} tabindex="-1" data-tab={i}>
        {p.verb}<i class="dot" aria-hidden="true"></i><span class="progress" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  <div class="panels">
    {PILLARS.map((p, i) => (
      <section class="panel" id={`panel-${p.key}`} data-panel={i}>
        <p class="panel-kicker">{p.label}</p>
        <h3>{p.title}</h3>
        <p class="panel-body">{p.body}</p>
        {pillarMetrics[p.key] && (
          <dl class="metrics">
            {pillarMetrics[p.key].map((m) => (
              <div>
                <dt class="tabular">{m.value}</dt>
                <dd>{m.label}</dd>
              </div>
            ))}
          </dl>
        )}
      </section>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pillars]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[data-tablist]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    if (!list || !tabs.length || tabs.length !== panels.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Les panneaux sont tous rendus visibles par le HTML. C'est le script, et
    // lui seul, qui les replie en onglets accessibles.
    list.removeAttribute('aria-hidden');
    list.setAttribute('role', 'tablist');
    list.setAttribute('aria-label', 'What it does');
    list.setAttribute('aria-orientation', 'vertical');

    tabs.forEach((tab, i) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panels[i].id);
    });
    panels.forEach((panel, i) => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[i].id);
      panel.tabIndex = 0;
    });
    root.dataset.ready = 'on';

    let current = 0;
    let timer = 0;
    let advances = 0;
    let userTook = false;

    const show = (next: number) => {
      current = (next + tabs.length) % tabs.length;
      tabs.forEach((t, i) => {
        const on = i === current;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, i) => {
        p.hidden = i !== current;
      });
      // Relance le filet de progression du verbe qui vient d'être choisi.
      const bar = tabs[current].querySelector<HTMLElement>('.progress');
      if (bar) {
        bar.style.animation = 'none';
        void bar.offsetWidth;
        bar.style.animation = '';
      }
    };

    const stopAuto = () => {
      if (timer) window.clearInterval(timer);
      timer = 0;
      root.dataset.auto = 'off';
    };

    // L'avance automatique fait un seul tour, puis s'arrête sur le premier
    // verbe. Elle ne démarre qu'à l'écran et jamais en mouvement réduit.
    const startAuto = () => {
      if (timer || userTook || reduced.matches || advances >= tabs.length) return;
      root.dataset.auto = 'on';
      show(current);
      timer = window.setInterval(() => {
        advances += 1;
        show(current + 1);
        if (advances >= tabs.length) stopAuto();
      }, 7000);
    };

    // Elle s'arrête définitivement dès que le visiteur prend la main, à la
    // souris, au clavier ou avec un lecteur d'écran qui pose le focus.
    const takeOver = () => {
      userTook = true;
      stopAuto();
    };

    root.addEventListener('focusin', takeOver);
    root.addEventListener('pointerenter', () => stopAuto());
    root.addEventListener('pointerleave', () => startAuto());

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        takeOver();
        show(i);
      });
      tab.addEventListener('keydown', (e) => {
        const k = e.key;
        let next: number | null = null;
        if (k === 'ArrowDown' || k === 'ArrowRight') next = current + 1;
        else if (k === 'ArrowUp' || k === 'ArrowLeft') next = current - 1;
        else if (k === 'Home') next = 0;
        else if (k === 'End') next = tabs.length - 1;
        if (next === null) return;
        e.preventDefault();
        takeOver();
        show(next);
        tabs[current].focus();
      });
    });

    show(0);

    // Déjà à l'écran au chargement : pas d'avance automatique.
    const r = root.getBoundingClientRect();
    if (r.top < window.innerHeight && r.bottom > 0) userTook = true;

    if (!reduced.matches && !userTook && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) startAuto();
            else stopAuto();
          }
        },
        { threshold: 0.4 }
      ).observe(root);
    }

    reduced.addEventListener('change', (e) => {
      if (e.matches) takeOver();
    });
  });
</script>

<style>
  .tabs {
    margin-top: clamp(56px, 7vw, 108px);
    row-gap: 48px;
    align-items: start;
  }

  .tablist {
    grid-column: 1 / span 6;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .tab {
    position: relative;
    appearance: none;
    background: none;
    border: 0;
    margin: 0;
    padding: 0 0 12px;
    font-family: var(--font-ui);
    font-size: clamp(40px, 5.6vw, 88px);
    font-weight: var(--w-title);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-align: left;
    color: var(--soot-2);
    cursor: pointer;
    transition: color 0.25s ease;
  }

  .tab:hover {
    color: var(--ash-2);
  }

  .tab[aria-selected='true'] {
    color: var(--fg);
  }

  .tab .dot {
    opacity: 0;
    transform: scale(0.3);
    transition:
      opacity 0.2s ease,
      transform 0.35s cubic-bezier(0.2, 0.9, 0.25, 1.3);
  }

  .tab[aria-selected='true'] .dot {
    opacity: 1;
    transform: none;
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 2px;
    background: var(--dot);
    transform: scaleX(0);
    transform-origin: left center;
  }

  [data-auto='on'] .tab[aria-selected='true'] .progress {
    animation: progress 7s linear forwards;
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  .panels {
    grid-column: 8 / span 5;
    padding-top: clamp(6px, 1.2vw, 20px);
  }

  /* Sans script, les quatre panneaux s'empilent et se lisent tous. */
  .panel + .panel {
    margin-top: 64px;
  }

  [data-ready='on'] .panel + .panel {
    margin-top: 0;
  }

  .panel-kicker {
    font-size: 15px;
    color: var(--meta);
    margin-bottom: 18px;
  }

  .panel h3 {
    font-size: var(--t-h3);
    line-height: var(--lh-h3);
    letter-spacing: -0.022em;
    max-width: 20ch;
  }

  .panel-body {
    margin-top: 22px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg-2);
    max-width: 44ch;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
    margin-top: var(--s-7);
  }

  .metrics div {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .metrics dt {
    font-size: 38px;
    font-weight: 600;
    line-height: 1;
    color: var(--fg);
  }

  .metrics dd {
    margin: 0;
    font-size: var(--t-small);
    color: var(--meta);
    max-width: 22ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-ready='on'] .panel:not([hidden]) {
      animation: rise 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1180px) {
    .panels {
      grid-column: 7 / -1;
    }
  }

  @media (max-width: 900px) {
    .tablist,
    .panels {
      grid-column: 1 / -1;
    }
  }
</style>
