---
// Document reproduit. Avec le papier de la démonstration des factures, c'est
// le seul endroit du site où la mono est du contenu et non de la décoration.
// Données entièrement fictives (src/data/documents.ts).
//
// Chaque ligne lue et rapprochée de sa source porte une coche cuivre, la
// marque de ce que fait Syntexia. Les lignes caviardées n'en portent pas : ce
// que nous ne montrons pas, nous ne prétendons pas l'avoir montré.
//
// Chaque pièce garde sa langue (portugais, espagnol, français, anglais) et
// la déclare dans lang, pour que les lecteurs d'écran la prononcent
// correctement.
import type { SampleDocument } from '../data/documents';

interface Props {
  doc: SampleDocument;
  class?: string;
}
const { doc, class: cls = '' } = Astro.props;
const { heading, rows, total, lang } = doc;
// Une pièce qui porte une ligne signalée n'a pas de coche sur son total : le
// calcul est juste, mais la pièce n'est pas validée.
const hasFlag = rows.some((r) => r.flagged);
---
<div class={`sheet ${cls}`.trim()} lang={lang}>
  <p class="sheet-head">{heading}</p>
  <table>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td>{r.label}</td>
          <td class="n">{r.redacted ? <span class="black" role="img" aria-label="Redacted" lang="en"></span> : r.value}</td>
          <td class="t">
            {r.flagged ? (
              <>
                <svg class="tick flag" viewBox="0 0 16 16" aria-hidden="true">
                  <circle cx="8" cy="8" r="6.6"></circle>
                  <path d="M8 4.6v4.4"></path>
                  <path d="M8 11.3v.1"></path>
                </svg>
                <span class="sr-only" lang="en">Flagged</span>
              </>
            ) : (
              !r.redacted && (
                <svg class="tick" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M3 8.6l3.2 3.1L13 4.6"></path>
                </svg>
              )
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  {total && (
    <>
      <div class="sheet-rule"></div>
      <table>
        <tbody>
          <tr>
            <td>{total.label}</td>
            <td class="n">{total.value}</td>
            <td class="t">
              {!hasFlag && (
                <svg class="tick" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M3 8.6l3.2 3.1L13 4.6"></path>
                </svg>
              )}
            </td>
          </tr>
        </tbody>
      </table>
    </>
  )}
</div>

<style>
  /* Une feuille de papier posée : blanc, encre presque noire, ombre de
     contact. L'ombre est la conséquence d'un objet posé, pas un effet. */
  .sheet {
    background: var(--white);
    color: var(--typewriter);
    font-family: var(--font-mono);
    font-size: 14.5px;
    line-height: 1.5;
    padding: 26px 28px 30px;
    box-shadow: var(--shadow-sheet);
  }

  /* En-tête d'une pièce reproduite, pas une section de la page. */
  .sheet-head {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--black);
    letter-spacing: 0.02em;
    margin-bottom: 16px;
    max-width: none;
  }

  .sheet table {
    width: 100%;
    border-collapse: collapse;
  }

  .sheet td {
    padding: 3px 0;
    vertical-align: baseline;
  }

  .sheet td.n {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .sheet td.t {
    width: 28px;
    text-align: right;
    white-space: nowrap;
  }

  .sheet-rule {
    border-top: 1px solid var(--typewriter);
    margin: 10px 0 6px;
  }

  .black {
    display: inline-block;
    width: 84px;
    height: 11px;
    background: var(--black);
    vertical-align: middle;
  }

  .tick {
    display: inline-block;
    width: 15px;
    height: 15px;
    vertical-align: -2px;
    fill: none;
    stroke: var(--copper);
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 760px) {
    .sheet {
      font-size: 13.5px;
      padding: 22px 20px 24px;
    }
  }
</style>
