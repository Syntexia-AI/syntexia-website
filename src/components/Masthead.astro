---
import BrandMark from './BrandMark.astro';
import MobileMenu from './MobileMenu.astro';
import { securityIsLinked } from '../facts';

const links = [
  { href: '/about', label: 'About' },
  { href: '/team', label: 'Team' },
  { href: '/blog', label: 'Insights' },
  // /security n'est liée qu'à partir de trois entrées sourcées.
  ...(securityIsLinked ? [{ href: '/security', label: 'Security' }] : []),
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="masthead">
  <div class="shell masthead-inner">
    <a href="/" class="brand">
      <BrandMark />
      <span class="brand-name">Syntexia<span>.AI</span></span>
    </a>

    <nav class="nav-links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <MobileMenu links={links} />
  </div>
</header>
